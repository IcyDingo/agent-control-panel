# Copy to .env beside compose.yml and fill in. hub/README.md has the table of settings.
HUB_PUBLIC_URL=https://universe.cashegg.com
HUB_TRUST_PROXY=1
# Sign in with GitHub: an OAuth App at github.com/settings/developers with
#   Homepage URL:               https://universe.cashegg.com
#   Authorization callback URL: https://universe.cashegg.com/auth/github/callback
# After editing, run ./update.sh here.
HUB_GITHUB_CLIENT_ID=
HUB_GITHUB_CLIENT_SECRET=
